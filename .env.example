# Copy to your per-user pestrail config and fill in. Never commit it.
#   Windows:       %APPDATA%\pestrail\.env
#   macOS / Linux: ~/.config/pestrail/.env  (or $XDG_CONFIG_HOME/pestrail/.env)
# A .env in the working directory is NOT loaded automatically; point PESTRAIL_ENV_FILE at it
# to use one explicitly. Real environment variables (e.g. MCP client config) always win.
# Only TESTRAIL_* and PESTRAIL_* keys are read from this file. If TESTRAIL_API_KEY is set in
# the real environment, TESTRAIL_URL / TESTRAIL_CA_BUNDLE / TESTRAIL_ALLOW_HTTP must be set
# there too (pestrail refuses to take them from this file).
TESTRAIL_URL=https://your-company.testrail.io
TESTRAIL_USERNAME=you@example.com
TESTRAIL_API_KEY=your-api-key-here

# Optional
# TESTRAIL_READ_ONLY=true
# Separate multiple directories with ';' on Windows and ':' on macOS/Linux.
# TESTRAIL_ATTACHMENT_ROOTS=C:\Users\you\test-artifacts;D:\ci-logs
# TESTRAIL_TIMEOUT=30
# Only if your company's CA is not in the OS certificate store:
# TESTRAIL_CA_BUNDLE=C:\certs\company-root-ca.pem
